    ]
    
    path_sum_local = os.path.join(folder_tahap19, "ringkasan_ablasi.csv")
    path_sum_final = os.path.join(dir_hasil_final, "ringkasan_ablasi.csv")

    for p in [path_sum_local, path_sum_final]:
