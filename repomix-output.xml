    print("=" * 130)

    # Ekspor ke ringkasan_ablasi.csv
    summary_headers = [
        "instance", "konfigurasi", "keterangan", "bks", "n_run", "n_layak", "persen_layak",
        "jarak_terbaik", "jarak_rata2", "jarak_terburuk", "std_dev",
