            w = csv.DictWriter(f, fieldnames=analisis_headers)
            w.writeheader()
            w.writerows(rekap_analisis_rows)

    print(f"\n[OK] File ringkasan berhasil disimpan ke:\n   - {path_sum_final}")


if __name__ == "__main__":
