"""
repair.py — TAHAP 14/19
Operator perbaikan solusi: greedy_insertion dan regret2_insertion.
"""


class RepairOperator:
    DAFTAR = ["greedy_insertion", "regret2_insertion"]

    def __init__(self, instance):
        self.instance = instance

    def jalankan(self, nama, solusi, bank):
        fn = getattr(self, nama, None)
        if fn is None:
            raise ValueError(f"Operator perbaikan '{nama}' tidak dikenal.")
        return fn(solusi, bank)

    def _masukkan_node(self, solusi, node, rute_terpilih, posisi_terpilih):
        # 1. Coba di rute terpilih jika muat
        if rute_terpilih is not None and posisi_terpilih is not None and rute_terpilih.masih_muat(node):
            rute_terpilih.sisip_di(posisi_terpilih, node)
            return True

        # 2. Cari rute aktif di solusi yang masih muat (posisi terbaik)
        pos_terbaik, rute_terbaik, biaya_min = None, None, float("inf")
        for r in solusi.daftar_rute:
            if r.masih_muat(node):
                p, b = r.sisip_terbaik(node)
                if p is not None and b < biaya_min:
                    biaya_min = b
                    pos_terbaik = p
                    rute_terbaik = r
        if rute_terbaik is not None:
            rute_terbaik.sisip_di(pos_terbaik, node)
            return True

        # 3. Cari rute kosong yang tersedia di solusi
        for r in solusi.daftar_rute:
            if r.kosong() and r.masih_muat(node):
                r.tambah_node(node)
                return True

        # 4. Jika rute < armada, siapkan rute baru dari armada
        solusi.siapkan_armada()
        for r in solusi.daftar_rute:
            if r.kosong() and r.masih_muat(node):
                r.tambah_node(node)
                return True
        if len(solusi.daftar_rute) < self.instance.jumlah_kendaraan:
            r_baru = solusi.rute_baru()
            r_baru.tambah_node(node)
            return True

        # 5. Fallback: jika armada penuh dan semua rute aktif tidak muat,
        # sisipkan ke rute dengan sisa kapasitas terbesar / muatan terkecil
        best_r = max(solusi.daftar_rute, key=lambda r: r.sisa_kapasitas())
        p, _ = best_r.sisip_terbaik(node)
        if p is None:
            p = len(best_r.node_ids)
        best_r.sisip_di(p, node)
        return True

    def perbaiki_kelebihan_muatan(self, solusi):
        cap = self.instance.kapasitas
        for attempt in range(50):
            overloaded = [r for r in solusi.daftar_rute if r.total_muatan > cap]
            if not overloaded:
                break
            r1 = overloaded[0]
            fixed = False
            for pos1, v1 in enumerate(list(r1.daftar_visit)):
                q1 = v1.node
                for r2 in solusi.daftar_rute:
                    if r2 != r1 and r2.masih_muat(q1):
                        r1.keluarkan_di(pos1)
                        p2, _ = r2.sisip_terbaik(q1)
                        r2.sisip_di(p2, q1)
                        fixed = True
                        break
                if fixed:
                    break

                for r2 in solusi.daftar_rute:
                    if r2 == r1:
                        continue
                    for pos2, v2 in enumerate(list(r2.daftar_visit)):
                        q2 = v2.node
                        if (r1.total_muatan - q1.demand + q2.demand <= cap and 
                            r2.total_muatan - q2.demand + q1.demand <= cap):
                            r1.keluarkan_di(pos1)
                            r2.keluarkan_di(pos2)
                            p1, _ = r1.sisip_terbaik(q2)
                            r1.sisip_di(p1, q2)
                            p2, _ = r2.sisip_terbaik(q1)
                            r2.sisip_di(p2, q1)
                            fixed = True
                            break
                    if fixed:
                        break
                if fixed:
                    break

    def greedy_insertion(self, solusi, bank):
        solusi.siapkan_armada()
        while bank:
            biaya_min = float("inf")
            node_terbaik = None
            posisi_terbaik = None
            rute_terbaik = None

            for node in bank:
                for rute in solusi.daftar_rute:
                    pos, biaya = rute.sisip_terbaik(node)
                    if pos is not None and biaya < biaya_min:
                        biaya_min = biaya
                        node_terbaik = node
                        posisi_terbaik = pos
                        rute_terbaik = rute

            if node_terbaik is None:
                node_terbaik = bank[0]

            self._masukkan_node(solusi, node_terbaik, rute_terbaik, posisi_terbaik)
            bank.remove(node_terbaik)

        self.perbaiki_kelebihan_muatan(solusi)
        return True

    def regret2_insertion(self, solusi, bank):
        solusi.siapkan_armada()
        while bank:
            regret_maks = -float("inf")
            node_terpilih = None
            rute_terpilih = None
            posisi_terpilih = None

            for node in bank:
                pilihan = []
                for rute in solusi.daftar_rute:
                    pos, biaya = rute.sisip_terbaik(node)
                    if pos is not None:
                        pilihan.append((biaya, rute, pos))

                pilihan.sort(key=lambda x: x[0])

                if len(pilihan) == 0:
                    regret = float("inf")
                    r_best, p_best = None, None
                elif len(pilihan) == 1:
                    regret = pilihan[0][0]
                    r_best, p_best = pilihan[0][1], pilihan[0][2]
                else:
                    regret = pilihan[1][0] - pilihan[0][0]
                    r_best, p_best = pilihan[0][1], pilihan[0][2]

                if regret > regret_maks:
                    regret_maks = regret
                    node_terpilih = node
                    rute_terpilih = r_best
                    posisi_terpilih = p_best

            if node_terpilih is None:
                node_terpilih = bank[0]

            self._masukkan_node(solusi, node_terpilih, rute_terpilih, posisi_terpilih)
            bank.remove(node_terpilih)

        self.perbaiki_kelebihan_muatan(solusi)
        return True


def greedy_insertion(solusi, bank, instance=None):
    inst = instance if instance is not None else solusi.instance
    return RepairOperator(inst).greedy_insertion(solusi, bank)


def regret2_insertion(solusi, bank, instance=None):
    inst = instance if instance is not None else solusi.instance
    return RepairOperator(inst).regret2_insertion(solusi, bank)
